# vibetradez.com/server — trading API server.
# Copy to .env and fill in. All required vars cause the service to log.Fatal on boot if missing.

# ---- Required ----

# Postgres connection for the vibetradez DB.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/vibetradez?sslmode=require

# Transactional email (morning picks, EOD summary, weekly report).
RESEND_API_KEY=re_...

# Anthropic API key powering the daily trade picker (Claude).
ANTHROPIC_API_KEY=sk-ant-...

# Dedicated Postgres pool for in-process auth (users + sessions tables),
# separate from DATABASE_URL. Required: the server log.Fatals on boot
# without it.
AUTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/vibetradez_auth?sslmode=require

# In-process Google OAuth. The trading server runs the Google sign-in flow
# itself (/auth/google/start + /auth/google/callback); there is no external
# auth service. Both are required (log.Fatal on boot if missing). Create the
# OAuth client at console.cloud.google.com and register the callback URL
# below as an authorized redirect URI, or sign-in 400s with
# redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional ----

# Overrides the default Google OAuth callback URL
# (https://vibetradez.com/auth/google/callback). Whatever you set here must
# also be registered as an authorized redirect URI in the Google Cloud
# Console.
GOOGLE_CALLBACK_URL=https://vibetradez.com/auth/google/callback

# Session cookie the trading server sets on vibetradez.com after the Google
# OAuth callback. Validated against the AUTH_DATABASE_URL sessions table on
# every /api/* request.
SESSION_COOKIE_NAME=vt_session
SESSION_TTL_DAYS=30

# Model override. Default is set in internal/config/config.go and
# should be refreshed when the official Anthropic Go SDK ships new defaults.
ANTHROPIC_MODEL=claude-opus-4-8

# Schwab Market Data OAuth. Optional — live quotes degrade gracefully
# when unset. Complete the OAuth dance by visiting /auth/schwab.
SCHWAB_APP_KEY=
SCHWAB_SECRET=
SCHWAB_CALLBACK_URL=https://vibetradez.com/auth/callback
# Token-at-rest encryption key for Schwab persisted tokens (base64-encoded
# 32 bytes, generate with `openssl rand -base64 32`). Strongly recommended
# whenever SCHWAB_APP_KEY + SCHWAB_SECRET are set. If it is unset while the
# Schwab keys are present the server does NOT fail-fast: it logs a WARN and
# falls back to the legacy sha256(SCHWAB_SECRET) key so a first deploy still
# boots. Set this var to close that audit gap. Rotate it independently of
# SCHWAB_SECRET. On rotation existing persisted tokens become unrecoverable,
# so the operator must re-authorize via /auth/schwab.
SCHWAB_TOKEN_ENCRYPTION_KEY=

# Email defaults.
EMAIL_FROM=Vibe Tradez <trades@vibetradez.com>
# Comma-separated list of seed subscribers inserted on first boot.
EMAIL_RECIPIENTS=
# HMAC key for unsubscribe-link tokens embedded in every outbound
# subscriber email. Generate with `openssl rand -base64 32`. REQUIRED —
# the trading server refuses to boot without it. Don't lose this key.
UNSUBSCRIBE_HMAC_KEY=
# Optional rotation fallback. Comma-separated list of PREVIOUSLY-used
# UNSUBSCRIBE_HMAC_KEY values (each base64-encoded 32 bytes). New
# email links sign under UNSUBSCRIBE_HMAC_KEY; outstanding links in
# subscriber inboxes that were signed under the old key still
# validate because Verify falls back to the listed previous keys.
# Drop entries from this list to retire them. Empty = no fallback.
UNSUBSCRIBE_HMAC_KEY_PREVIOUS=

# HTTP port the server listens on inside its container. Traefik routes
# vibetradez.com /api/*, /auth/*, /health to this port.
SERVER_PORT=8080

# ---- Portfolio manager (LIVE trading via Schwab Trader API) ----
#
# Master switch. When false (default), the portfolio manager does not run
# (no crons register, no orders). When true, the manager trades LIVE with
# real money: it runs the daily session, the intraday risk sweep, and the
# EOD snapshot. There is no paper mode, so TRADING_ENABLED=true is the one
# deliberate action that puts real money at risk. Flip it to true only after
# the rest of this section is set.
#
# Going live ALSO requires: (1) "Accounts and Trading" product added to the
# app at developer.schwab.com, (2) re-running /auth/schwab to refresh the
# OAuth token with trading scope, (3) equity + options approval on the
# Schwab brokerage account.
TRADING_ENABLED=false

# Operator alert address (e.g. the Schwab refresh-token expiry nag).
# Distinct from the subscriber list.
OPERATOR_EMAIL=bordelonjayce@gmail.com

# Public base URL used for outbound links in emails.
PUBLIC_BASE_URL=https://vibetradez.com

# Portfolio cron schedules (cron syntax, America/New_York). Defaults shown.
# Session fires after the opening-auction settles; risk sweeps every 15
# min during market hours; EOD snapshot writes the equity curve at 16:00.
CRON_SCHEDULE_PORTFOLIO=30 12 * * 1-5
CRON_SCHEDULE_RISK=*/15 10-15 * * 1-5
CRON_SCHEDULE_EOD_SNAPSHOT=0 16 * * 1-5
