# vibetradez.com/server — trading API server.
# Copy to .env and fill in. All required vars cause the service to log.Fatal on boot if missing.

# ---- Required ----

# Postgres connection for the vibetradez DB.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/vibetradez?sslmode=require

# Transactional email (morning picks, EOD summary, weekly report).
RESEND_API_KEY=re_...

# Anthropic API key powering the daily trade picker (Claude).
ANTHROPIC_API_KEY=sk-ant-...

# Centralized auth service (auth.jaycebordelon.com). Trading server is a
# registered OAuth consumer; these credentials MUST match an entry in the
# auth service's OAUTH_CLIENTS_JSON.
VT_AUTH_BASE_URL=https://auth.jaycebordelon.com
VT_AUTH_CLIENT_ID=vibetradez
VT_AUTH_CLIENT_SECRET=CHANGE_ME_MATCH_AUTH_SERVICE
VT_AUTH_REDIRECT_URI=https://vibetradez.com/auth/sso/callback

# ---- Optional ----

# Public URL of the auth service that the browser is redirected to during
# /auth/sso/start. Defaults to https://auth.jaycebordelon.com.
VT_AUTH_PUBLIC_URL=https://auth.jaycebordelon.com

# Session cookie the trading server sets on vibetradez.com after OAuth
# callback. Holds the opaque access token issued by auth service.
SESSION_COOKIE_NAME=vt_session
SESSION_TTL_DAYS=30

# Model override. Default is set in internal/config/config.go and
# should be refreshed when the official Anthropic Go SDK ships new defaults.
ANTHROPIC_MODEL=claude-opus-4-7

# Schwab Market Data OAuth. Optional — live quotes degrade gracefully
# when unset. Complete the OAuth dance by visiting /auth/schwab.
SCHWAB_APP_KEY=
SCHWAB_SECRET=
SCHWAB_CALLBACK_URL=https://vibetradez.com/auth/callback
# Token-at-rest encryption key for Schwab persisted tokens. Generate
# with `openssl rand -base64 32`. REQUIRED when SCHWAB_APP_KEY +
# SCHWAB_SECRET are set; the trading server will fail-fast on boot
# without it. Rotate independently of SCHWAB_SECRET. On rotation,
# existing persisted tokens become unrecoverable — operator must
# re-authorize via /auth/schwab.
SCHWAB_TOKEN_ENCRYPTION_KEY=

# Email defaults.
EMAIL_FROM=Vibe Tradez <trades@vibetradez.com>
# Comma-separated list of seed subscribers inserted on first boot.
EMAIL_RECIPIENTS=
# HMAC key for unsubscribe-link tokens embedded in every outbound
# subscriber email. Generate with `openssl rand -base64 32`. REQUIRED —
# the trading server refuses to boot without it. Don't lose this key.
UNSUBSCRIBE_HMAC_KEY=
# Optional rotation fallback. Comma-separated list of PREVIOUSLY-used
# UNSUBSCRIBE_HMAC_KEY values (each base64-encoded 32 bytes). New
# email links sign under UNSUBSCRIBE_HMAC_KEY; outstanding links in
# subscriber inboxes that were signed under the old key still
# validate because Verify falls back to the listed previous keys.
# Drop entries from this list to retire them. Empty = no fallback.
UNSUBSCRIBE_HMAC_KEY_PREVIOUS=

# HTTP port the server listens on inside its container. Traefik routes
# vibetradez.com /api/*, /auth/*, /health to this port.
SERVER_PORT=8080

# ---- Portfolio manager (paper or live trading via Schwab Trader API) ----
#
# Master switch. When false (default), the portfolio manager does not run
# (no crons register, no orders). When true, the manager runs the daily
# session, the intraday risk sweep, and the EOD snapshot. Flip to true only
# after the rest of this section is set.
TRADING_ENABLED=false

# paper | live. Anything other than the literal string "live" resolves to
# paper — there is no fallback to live on misconfiguration. paper mode
# synthesizes fills from live Schwab marks; live mode submits real orders.
#
# Going live is the deliberate two-key action TRADING_ENABLED=true +
# TRADING_MODE=live, and ALSO requires: (1) "Accounts and Trading" product
# added to the app at developer.schwab.com, (2) re-running /auth/schwab to
# refresh the OAuth token with trading scope, (3) equity + options approval
# on the Schwab brokerage account. Recommended: run at least one paper
# session and read the transcript before flipping to live.
TRADING_MODE=paper

# Operator alert address (e.g. the Schwab refresh-token expiry nag).
# Distinct from the subscriber list.
OPERATOR_EMAIL=bordelonjayce@gmail.com

# Public base URL used for outbound links in emails.
PUBLIC_BASE_URL=https://vibetradez.com

# Portfolio cron schedules (cron syntax, America/New_York). Defaults shown.
# Session fires after the opening-auction settles; risk sweeps every 15
# min during market hours; EOD snapshot writes the equity curve at 16:00.
CRON_SCHEDULE_PORTFOLIO=45 9 * * 1-5
CRON_SCHEDULE_RISK=*/15 10-15 * * 1-5
CRON_SCHEDULE_EOD_SNAPSHOT=0 16 * * 1-5
