# Local dev overrides for docker-compose.local.yml. Copy to .env and fill in
# if you want to test real Google sign-in. Auth is in-process in the
# trading-server (there is no separate auth-service). Without these, the
# stack still boots — the server uses stub values and the /auth/google flow
# returns 400 from Google, which is fine unless you're exercising sign-in.
#
# Compose reads .env automatically from this directory.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# The trading-server registers this callback with Google. If you change the
# port or path here, update GOOGLE_CALLBACK_URL in docker-compose.local.yml
# too.
#   GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback
